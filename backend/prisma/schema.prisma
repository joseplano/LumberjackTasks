generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String                @id @default(uuid())
  name          String
  email         String                @unique
  passwordHash  String
  createdAt     DateTime              @default(now())
  statusChanges TicketStatusHistory[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Project {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  description String         @default("")
  gitRepoUrl  String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  columns     KanbanColumn[]
  labels      Label[]
  tickets     Ticket[]
  phases      Phase[]
  gitBranches GitBranch[]
  gitCommits  GitCommit[]

  @@map("projects")
}

model KanbanColumn {
  id                 String   @id @default(uuid())
  projectId          String
  name               String
  position           Int
  /// At most one per project. Enforced by the partial unique index
  /// "kanban_columns_projectId_completion_key" in
  /// prisma/migrations/<dir>/migration.sql — Prisma's schema language cannot
  /// express a filtered unique index, so it exists ONLY in that SQL file.
  /// See specs/001-terminal-column-sweep/research.md R2. Do not drop it.
  isCompletionColumn Boolean  @default(false)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets            Ticket[]

  @@map("kanban_columns")
}

model Label {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String   @default("#888888")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@map("labels")
}

model Ticket {
  id                     String                @id @default(uuid())
  projectId              String
  number                 Int
  parentTicketId         String?
  name                   String
  description            String                @default("")
  columnId               String?
  complexity             Int
  labelId                String?
  phaseId                String?
  tokensConsumed         Int                   @default(0)
  llmName                String?
  developmentTimeMinutes Int                   @default(0)
  /// Mirror of the branch the agent reported for this ticket. Written only
  /// through the agent-facing write path; there is no generator and no
  /// read-time derivation. null means "not reported yet" -- see
  /// specs/002-ticket-git-branch-view/spec.md FR-002. Deliberately NOT unique:
  /// one branch commonly hosts several tickets (FR-004).
  gitBranch              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // onDelete: Restrict must stay explicit: Prisma's default onDelete
  // depends on optionality (required -> Restrict, optional -> SetNull), and
  // this relation is optional (columnId is nullable for completed/off-board
  // tickets). Without an explicit action here, Prisma would declare SetNull,
  // which would silently null out columnId on column deletion and fabricate
  // "completed" tickets with no TicketStatusHistory row, no board.swept
  // audit entry, and no board.swept event -- see data-model.md, "The
  // existing foreign key keeps its default onDelete behavior" (Restrict, as
  // originally migrated).
  column                 KanbanColumn?         @relation(fields: [columnId], references: [id], onDelete: Restrict)
  label                  Label?                @relation(fields: [labelId], references: [id], onDelete: SetNull)
  phase                  Phase?                @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parent                 Ticket?               @relation("Subtickets", fields: [parentTicketId], references: [id], onDelete: Cascade)
  subtickets             Ticket[]              @relation("Subtickets")
  history                TicketStatusHistory[]
  commitLinks            GitCommitTicket[]

  @@unique([projectId, number])
  @@map("tickets")
}

model TicketStatusHistory {
  id              String   @id @default(uuid())
  ticketId        String
  fromColumnName  String
  toColumnName    String
  changedByUserId String
  changedAt       DateTime @default(now())
  tokensDelta     Int?
  timeDelta       Int?
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy       User     @relation(fields: [changedByUserId], references: [id])

  @@map("ticket_status_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model ProjectCodeCounter {
  id Int @id @default(autoincrement())

  @@map("project_code_counter")
}

model Phase {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String   @default("")
  position    Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@map("phases")
}

/// Reported by the agent, never derived by the backend: the backend cannot see a
/// working tree. The value is validated against this enum and anything else is a
/// 400 VALIDATION. Precedence is applied when reporting, not only when drawing --
/// a branch that is both merged and dirty is reported MERGED (FR-010, research R4).
enum GitBranchState {
  UNCOMMITTED
  ACTIVE
  MERGED
}

/// The letters `git diff --name-status` emits. A rename arrives as R###; the
/// similarity score is discarded and only R is stored (D6).
enum GitFileChange {
  A
  M
  D
  R
}

model GitBranch {
  id                   String         @id @default(uuid())
  projectId            String
  name                 String
  /// Reported by the agent. Checked before `state` when choosing a colour (FR-011).
  isTrunk              Boolean        @default(false)
  /// A plain branch name, deliberately NOT a self-referencing foreign key: an
  /// optional self-relation would take Prisma's optionality-driven default
  /// (SetNull) and would force branches to be synced in dependency order. The
  /// drawn structure comes from GitCommit.parentShas regardless -- research R5.
  forkedFromBranchName String?
  /// Required with no default, so an omitted state is a validation error rather
  /// than a silent UNCOMMITTED.
  state                GitBranchState
  /// Set by the server clock on every sync that carries this branch; never
  /// client-supplied. A mirror that can be told it is fresh is not a mirror.
  lastSyncedAt         DateTime
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits              GitCommit[]

  /// Branch identity within a project (FR-026): this is what makes a re-sync an
  /// update instead of a duplicate.
  @@unique([projectId, name])
  @@map("git_branches")
}

model GitCommit {
  id                 String            @id @default(uuid())
  projectId          String
  /// The branch the commit was INTRODUCED on. Set when the commit is first
  /// recorded and NEVER updated, including when its branch is later merged into
  /// the trunk (FR-024/D8). An invariant of the write path, not a hint.
  branchId           String
  sha                String
  message            String
  /// Author display name. No email is stored; none is needed and it is avoidable
  /// personal data.
  authorName         String
  committedAt        DateTime
  /// Recorded per D6. Never affects colour (FR-013).
  pushed             Boolean           @default(false)
  isMerge            Boolean           @default(false)
  /// Ordered; parentShas[0] is the first parent. Empty for the root commit.
  /// Source of every fork and merge edge (FR-007).
  parentShas         String[]
  /// How many changed files were NOT stored because the 500-file cap was hit
  /// (FR-023). 0 means the stored list is complete.
  truncatedFileCount Int               @default(0)
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch             GitBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  files              GitCommitFile[]
  ticketLinks        GitCommitTicket[]

  /// A SHA appears at most once per project. This is what enforces D8/FR-024: a
  /// commit cannot be re-attributed by appearing under a second branch.
  @@unique([projectId, sha])
  @@index([branchId])
  @@map("git_commits")
}

model GitCommitFile {
  id         String        @id @default(uuid())
  commitId   String
  /// Repository-relative path. For a rename, the new path.
  path       String
  changeType GitFileChange
  commit     GitCommit     @relation(fields: [commitId], references: [id], onDelete: Cascade)

  /// Makes a re-sync of the same commit idempotent (FR-026).
  @@unique([commitId, path])
  @@index([commitId])
  @@map("git_commit_files")
}

/// Stores ONLY links the agent explicitly reported. Inferred links are never
/// stored; they are derived when read (research R6, D9, FR-025). There is
/// deliberately no `inferred` column -- a row's existence IS the claim that the
/// link was reported.
model GitCommitTicket {
  id       String    @id @default(uuid())
  commitId String
  ticketId String
  commit   GitCommit @relation(fields: [commitId], references: [id], onDelete: Cascade)
  // onDelete: Cascade must stay explicit and is load-bearing. This relation is
  // required, and Prisma's default onDelete for a REQUIRED relation is Restrict.
  // Left implicit, this table would make deleting any ticket that has a commit
  // link fail with a foreign-key error, silently breaking existing working
  // behaviour (deleting a ticket). No Prisma command proves this -- only the
  // regression test in tests/integration/tickets.test.ts does. See research R7.
  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Idempotent re-sync (FR-026).
  @@unique([commitId, ticketId])
  @@map("git_commit_tickets")
}
