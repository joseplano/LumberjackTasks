# Copy to backend/.env and fill in real values. Never commit the real .env.
DATABASE_URL=postgresql://lumberjack_tasks:lumberjack_tasks@127.0.0.1:5434/lumberjack_tasks

# REQUIRED in production. Generate a strong one with:  openssl rand -hex 32
# In production the backend refuses to start with a weak/missing secret.
# In development, if left blank a random per-run secret is used (sessions reset on restart).
JWT_SECRET=

# Comma-separated list of allowed browser origins. Defaults to http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

PORT=4000
